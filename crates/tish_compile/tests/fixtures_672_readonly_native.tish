declare fn sinkRO(w: i32, h: i32, readonly data: i32[]): void
declare fn sinkPlain(w: i32, h: i32, data: i32[]): void

let A: i32[] = []
let B: i32[] = []
let C: i32[] = []
let ai: i32 = 0
while (ai < 8) { A.push(ai & 7); ai = ai + 1 }
let bi: i32 = 0
while (bi < 8) { B.push(bi & 7); bi = bi + 1 }
let ci: i32 = 0
while (ci < 8) { C.push(ci & 7); ci = ci + 1 }

export fn sumA(): i32 { let acc: i32 = 0; let i: i32 = 0; while (i < 8) { acc = acc + A[i]; i = i + 1 } return acc }
export fn sumB(): i32 { let acc: i32 = 0; let i: i32 = 0; while (i < 8) { acc = acc + B[i]; i = i + 1 } return acc }
export fn sumC(): i32 { let acc: i32 = 0; let i: i32 = 0; while (i < 8) { acc = acc + C[i]; i = i + 1 } return acc }

export fn handOver() {
  sinkRO(2, 4, B)
  sinkPlain(2, 4, C)
}
fn main() { console.log(sumA() + "," + sumB() + "," + sumC()) }
main()
