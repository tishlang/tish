# Materialized by scripts/install-bin.js (postinstall / pre-pack)
bin/tish-format

# Rust payload: real copies while scripts/prepack.js is packing, and possibly symlinks into the
# repo root the rest of the time, if a local dev setup put them there. No trailing slashes — these
# are symlinks as often as they are directories, and `/crates/` does not match a symlink.
/Cargo.toml
/crates
/LICENSE
/justfile
/.pack-payload-state.json
