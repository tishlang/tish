let C = []
let D = []
let names = []
let i = 0
while (i < 4) { C.push(i); D.push(i); i = i + 1 }
let s = "a"
let j = 0
while (j < 3) { names.push(s); j = j + 1 }
fn main() {
  console.log("C=" + C[0] + C[3] + " D=" + D[0] + D[3])
  console.log("names=" + names[0] + names[2] + " len=" + names.length)
}
main()
