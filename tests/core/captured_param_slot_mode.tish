// #716 follow-up: functions whose params are CAPTURED by a nested closure stay in VM
// general slot mode via a captured-param copy-in prologue; the scope remains the single
// source of truth for those params. Behavior must be identical across interp / vm /
// native and with TISH_VM_SLOTS=0.
//
// Scope note: this corpus fixture holds the READ-ONLY-capture shapes (the #716 leak
// class — helper reads the enclosing param). Shapes where the param is REASSIGNED
// around a capture live in crates/tish_vm/tests/captured_param_slot_mode.rs instead:
// the AOT rust-native backend has a pre-existing divergence there (per-variable
// by-value capture reads stale values; a closure WRITE to a captured param fails to
// compile with E0594), unrelated to the VM slot machinery.

function handleEvent(payload) {
  function fmt(x) { return x + payload.tag }
  return fmt("v")
}
console.log(handleEvent({ tag: "t" }))

function withDefault(a, p = 5) {
  function get() { return p }
  let r = a + get()
  return r
}
console.log(withDefault(1))
console.log(withDefault(1, 2))

function escape(p) {
  function get() { return p }
  let unused = 0
  return get
}
let g = escape(4)
console.log(g())

function recur(n) {
  function dec() { return n - 1 }
  if (n === 0) { return 0 }
  let x = recur(dec())
  return x + n
}
console.log(recur(3))

function mixed(a, b) {
  function useA() { return a }
  let c = b * 2
  let r = useA() + c
  return r
}
console.log(mixed(1, 2))

function twoCaptured(a, b) {
  function sum() { return a + b }
  let r = sum() * 2
  return r
}
console.log(twoCaptured(3, 4))
