let g: i32 = 5
let s = "a"
let n = 1

fn setG(x: i32) { g = x * 2 }
fn setS(v) { s = v + "!" }
fn bump(v) { n = v + 10 }
fn readOnly(x: i32): i32 { return x + 1 }

fn main() {
  console.log("g0=" + g)
  console.log("ro=" + readOnly(g))
  setG(g)
  console.log("g1=" + g)
  setG(g)
  console.log("g2=" + g)
  setS(s)
  console.log("s1=" + s)
  setS(s)
  console.log("s2=" + s)
  bump(n)
  console.log("n1=" + n)
}
main()
