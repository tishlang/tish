// #247: a closure created in a FUNCTION BODY must keep that body's bindings after the call returns.
//
// The bytecode VM keeps a frame's name-based locals in one flat map, and `ExitBlock` REMOVES the
// block's names from it — including from the map escaped closures captured by reference. A function
// body is compiled as a block, so `fn f() { let v = 1; out.push(() => v) }` lost `v` the moment `f`
// returned ("Undefined variable: v") while the interpreter and node were fine. An explicit `return`
// masked it, because `Return` jumps over the trailing `ExitBlock`.
//
// Fix: a function body's outermost block emits no `EnterBlock`/`ExitBlock`. Its bindings live in the
// frame-local map, which is created per call and dropped at return — there is nothing to restore or
// hide, so the teardown was pure loss.
//
// This is the shape behind `describe("x", () => { let state = []; beforeEach(() => state.push(1)) })`.
//
// KNOWN GAP (still diverges, tracked on #247): the same removal still breaks captures for blocks
// NESTED inside a function — a bare `{ … }`, an `if` body, or a loop body that declares a `let` a
// closure captures. Those need the VM to give each block its own scope map rather than one flat map
// per frame; they are deliberately not exercised here so this fixture stays a green gate.

// --- escaping a function body (no explicit return: the shape that used to fail) ---
let out = []
fn setup() {
  let v = 41
  out.push(() => v + 1)
}
setup()
console.log(out[0]())

// --- same, with an explicit return (used to work; must keep working) ---
let out2 = []
fn setupReturning() {
  let v = 41
  out2.push(() => v + 1)
  return null
}
setupReturning()
console.log(out2[0]())

// --- escaping via a helper that stores the closure ---
let hooks = []
fn addHook(h) { hooks.push(h) }
fn register() {
  let label = "hook"
  addHook(() => label + "!")
}
register()
console.log(hooks[0]())

// --- escaping via index and member assignment ---
let slot = [null]
let holder = { f: null }
fn assign() {
  let n = 7
  slot[0] = () => n * 2
  holder.f = () => n * 3
}
assign()
console.log(slot[0](), holder.f())

// --- an arrow's body block, not just a `fn` ---
let arrowOut = []
let build = () => {
  let tag = "arrow"
  arrowOut.push(() => tag)
}
build()
console.log(arrowOut[0]())

// --- the binding stays live: a write before the call returns is visible through the closure ---
let live = []
fn mutating() {
  let c = 1
  live.push(() => c)
  c = 2
}
mutating()
console.log(live[0]())

// --- mutation THROUGH a captured reference (the beforeEach shape) ---
let mutators = []
fn stateful() {
  let state = []
  mutators.push(() => { state.push(1); return state.length })
}
stateful()
console.log(mutators[0](), mutators[0](), mutators[0]())

// --- a body `let` shadowing an outer binding is not visible to the caller ---
let shadowed = "outer"
fn shadowing() {
  let shadowed = "inner"
  return shadowed
}
console.log(shadowing(), shadowed)

// --- each call gets its own binding: two closures from two calls must not share ---
let perCall = []
fn once(tag) {
  let captured = tag
  perCall.push(() => captured)
}
once("first")
once("second")
console.log(perCall[0](), perCall[1]())

// --- nested functions still resolve every ancestor's locals ---
fn outerFn() {
  let a = 1
  fn middle() {
    let b = 2
    return () => a + b
  }
  return middle()
}
console.log(outerFn()())
